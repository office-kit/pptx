<?xml version="1.0" encoding="UTF-8"?>
<!-- The one attribute of the XML namespace (https://www.w3.org/2001/xml.xsd)
     that ECMA-376's math schema uses. ECMA-376 imports the namespace without a
     schema location, which xmllint cannot resolve offline. -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://www.w3.org/XML/1998/namespace">
  <xsd:attribute name="space">
    <xsd:simpleType>
      <xsd:restriction base="xsd:NCName">
        <xsd:enumeration value="default"/>
        <xsd:enumeration value="preserve"/>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:attribute>
</xsd:schema>
